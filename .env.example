# =============================================================================
# ECAD Java — Variáveis de Ambiente (Copie para .env e preencha)
# =============================================================================

# --- MODO DE OPERAÇÃO ---
# true  = Local (filesystem, sem Docker infra)
# false = Cloud local (Docker infra: mongodb, azurite, kafka)
LOCAL_DEVELOPMENT_ENABLED=false
LOCAL_DEVELOPMENT_ROOT=.localdev
COMPOSE_PROJECT_NAME=ecad

# --- MONGODB (Docker service name) ---
MONGODB_CONNECTION_STRING=mongodb://mongodb:27017
MONGODB_DATABASE_NAME=ecad-captacao

# --- AZURITE (Docker service name) ---
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
AZURE_BLOB_CONTAINER_NAME=captura-documentos

# --- KAFKA (Docker service name - modo cloud) ---
# Para modo local (host, sem Docker infra), altere para: localhost:9094
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- KAFKA SASL/SSL (Azure Event Hubs) ---
# Em produção (Event Hubs), usar:
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.plain.PlainLoginModule required username="$ConnectionString" password="<EVENT_HUBS_CONNECTION_STRING>";
# Alternativamente, use KAFKA_SASL_USERNAME e KAFKA_SASL_PASSWORD separadamente (recomendado para Azure Container Apps):
# KAFKA_SASL_USERNAME=RootManageSharedAccessKey
# KAFKA_SASL_PASSWORD=<shared-access-key>

# --- IA PROVIDERS (PREENCHA COM SUAS CHAVES) ---
AI_PROVIDER_CHAIN=openrouter,gemini_nativo,ollama,azure_openai
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=glm-ocr:latest
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# --- SGA (ECAD) ---
SGA_VERIFICATION_ENABLED=false
SGA_OAUTH_URL=https://api-prd.ecad.org.br/oauth-rfc/v1/access-token
SGA_BASE_URL=https://backend.ecad.org.br/arrecadacao/api-show
SGA_CLIENT_ID=
SGA_CLIENT_SECRET=
SGA_USER=
SGA_TIMEOUT_SECONDS=10
SGA_MAX_RETRIES=3

# --- CONTROL CENTER ---
CONTROL_CENTER_SCHEDULING_ENABLED=true
AGENDAMENTO_INTERVAL_MS=60000